# Copiar como .env y ajustar. .env no se versiona.

# PostgreSQL (también la usa Airflow)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_PORT=5432

# Kafka
KAFKA_PORT=9092

# CSV del NSRDB, relativo a /app dentro del contenedor del productor.
# El archivo va en producer/data/ antes de construir la imagen.
DATA_FILE_PATH=data/2022-1217132-one_axis.csv
